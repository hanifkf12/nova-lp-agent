# ==========================================
# NOVA LP AGENT — ENV TEMPLATE
# Copy ke .env dan isi semua value
# JANGAN commit .env ke GitHub!
# ==========================================

# === SOLANA WALLET ===
WALLET_PRIVATE_KEY=your_base58_private_key
SOLANA_RPC=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
SOLANA_RPC_FALLBACKS=                  # comma-separated, rotates on RPC error

# === LLM (OpenRouter) ===
OPENROUTER_API_KEY=sk-or-v1-...
LLM_BASE_URL=https://openrouter.ai/api/v1
HUNTER_MODEL=anthropic/claude-sonnet-4.5    # entry decisions — quality matters
HEALER_MODEL=anthropic/claude-haiku-4.5     # frequent, rule-bounded
LESSON_MODEL=anthropic/claude-haiku-4.5     # post-close summary

# === API KEYS ===
HELIUS_API_KEY=your_helius_key
BIRDEYE_API_KEY=your_birdeye_key        # optional, tambah sinyal + SOL price fallback

# === TELEGRAM ===
TELEGRAM_BOT_TOKEN=your_bot_token
TELEGRAM_CHAT_ID=your_chat_id

# === MODAL & RISK ===
TOTAL_CAPITAL_SOL=2.0                  # total modal dalam SOL
MAX_POSITION_SOL=0.4                   # max per posisi (20%)
MAX_POSITIONS=5                        # max posisi terbuka
MIN_POSITION_SOL=0.05                  # minimum deploy
STOP_LOSS_PCT=0.15                     # stop loss 15% dari modal posisi
TAKE_PROFIT_PCT=0.25                   # take profit 25%
MAX_DRAWDOWN_PCT=0.30                  # emergency stop 30% total

# === SCREENING THRESHOLDS ===
MIN_TVL=8000                           # minimum TVL pool ($)
MAX_TVL=500000                         # max TVL (terlalu besar = fee kecil)
MIN_FEE_TVL_RATIO=0.05                 # minimum fee/TVL ratio (5%)
MIN_VOLUME_24H=20000                   # minimum volume 24h ($)
MIN_HOLDERS=100                        # minimum holder count
MAX_MCAP=5000000                       # max market cap ($5M)
MIN_ORGANIC_SCORE=50                   # Meteora organic score minimum
MIN_BIN_STEP=50                        # minimum bin step
MAX_BIN_STEP=200                       # maximum bin step

# === TIMING ===
HUNTER_INTERVAL_MIN=15                 # scan pool baru setiap N menit
HEALER_INTERVAL_MIN=5                  # monitor posisi setiap N menit
DAILY_REPORT_HOUR_UTC=13               # laporan jam 20 WIB

# === MODE ===
DRY_RUN=true                           # true = tidak ada transaksi nyata
LOG_LEVEL=info
DB_PATH=./data/nova.db

# === STRATEGY ===
# spot | curve | bid_ask | auto
LP_STRATEGY=auto                       # auto = LLM pilihkan terbaik
BIN_RANGE=69                           # jumlah bin (default Meteora: 69)
